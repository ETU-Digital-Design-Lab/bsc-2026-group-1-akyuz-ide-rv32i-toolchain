// rv32i_full_test.hex — Comprehensive RV32I Instruction Coverage
//
// Tests all 37 unique RV32I instruction types:
//   R-type  : ADD SUB AND OR XOR SLL SRL SRA SLT SLTU
//   I-arith : ADDI ANDI ORI XORI SLLI SRLI SRAI SLTI SLTIU
//   U-type  : LUI AUIPC
//   Load    : LW LB LBU LH LHU
//   Store   : SW SB SH
//   Branch  : BEQ BNE BLT BGE BLTU BGEU  (all taken)
//   Jump    : JAL JALR
//
// Register inputs (set in init, used as operands):
//   x1 = 5   x2 = -5 (0xFFFFFFFB)   x3 = 3   x4 = 64 (DMEM base)
//
// Expected register values at halt (PC=0x0E4):
//   x1  = 5            x2  = 0xFFFFFFFB    x3  = 0x0000_00DC (JALR ret)
//   x4  = 0xE0         x5  = 7             x6  = 8   (ADD)
//   x7  = 2            x8  = 1   (AND)     x9  = 7   (OR)
//   x10 = 6  (XOR)     x11 = 40  (SLL)     x12 = 0   (SRL)
//   x13 = 0xFFFFFFFF   x14 = 1   (SLT)     x15 = 0   (SLTU)
//   x16 = 15 (ADDI)    x17 = 4   (ANDI)    x18 = 7   (ORI)
//   x19 = 3  (XORI)    x20 = 20  (SLLI)    x21 = 2   (SRLI)
//   x22 = 0xFFFFFFFD   x23 = 1   (SLTI)    x24 = 0   (SLTIU)
//   x25 = 0x12345000   x26 = 0x1064        x27 = 5   (LW)
//   x28 = 0xFFFFFFFB   x29 = 251 (LBU)     x30 = 5   (LH)
//   x31 = 5  (LHU)
//
// DMEM (byte addresses):
//   [64]  = 0x00000005  (SW)
//   [68]  = 0x000000FB  (SB: low byte = 0xFB)
//   [72]  = 0x00000005  (SH: low halfword = 0x0005)
//
// ============================================================
// Phase 1: Initialise operand registers
// ============================================================
//
// PC=0x000  addi x1, x0, 5
00500093
// PC=0x004  addi x2, x0, -5      x2 = 0xFFFFFFFB
FFB00113
// PC=0x008  addi x3, x0, 3
00300193
// PC=0x00C  addi x4, x0, 64      x4 = DMEM base
04000213
// PC=0x010  addi x5, x0, 0       x5 = 0 (scratch)
00000293
//
// ============================================================
// Phase 2: R-type instructions
// ============================================================
//
// PC=0x014  add  x6,  x1, x3     x6  = 8
00308333
// PC=0x018  sub  x7,  x1, x3     x7  = 2
403083B3
// PC=0x01C  and  x8,  x1, x3     x8  = 1  (5 & 3)
0030F433
// PC=0x020  or   x9,  x1, x3     x9  = 7  (5 | 3)
0030E4B3
// PC=0x024  xor  x10, x1, x3     x10 = 6  (5 ^ 3)
0030C533
// PC=0x028  sll  x11, x1, x3     x11 = 40 (5 << 3)
003095B3
// PC=0x02C  srl  x12, x1, x3     x12 = 0  (5 >> 3)
0030D633
// PC=0x030  sra  x13, x2, x3     x13 = 0xFFFFFFFF  (-5 SRA 3)
403156B3
// PC=0x034  slt  x14, x2, x1     x14 = 1  (-5 < 5 signed)
00112733
// PC=0x038  sltu x15, x2, x1     x15 = 0  (0xFFFFFFFB < 5 unsigned = false)
001137B3
//
// ============================================================
// Phase 3: I-type arithmetic
// ============================================================
//
// PC=0x03C  addi  x16, x1, 10    x16 = 15
00A08813
// PC=0x040  andi  x17, x1, 6     x17 = 4  (5 & 6)
0060F893
// PC=0x044  ori   x18, x1, 6     x18 = 7  (5 | 6)
0060E913
// PC=0x048  xori  x19, x1, 6     x19 = 3  (5 ^ 6)
0060C993
// PC=0x04C  slli  x20, x1, 2     x20 = 20 (5 << 2)
00209A13
// PC=0x050  srli  x21, x1, 1     x21 = 2  (5 >> 1)
0010DA93
// PC=0x054  srai  x22, x2, 1     x22 = 0xFFFFFFFD  (-5 SRA 1 = -3)
40115B13
// PC=0x058  slti  x23, x2, 1     x23 = 1  (-5 < 1 signed)
00112B93
// PC=0x05C  sltiu x24, x2, 1     x24 = 0  (0xFFFFFFFB < 1 unsigned = false)
00113C13
//
// ============================================================
// Phase 4: LUI / AUIPC
// ============================================================
//
// PC=0x060  lui   x25, 0x12345   x25 = 0x12345000
12345CB7
// PC=0x064  auipc x26, 0x1       x26 = 0x064 + 0x1000 = 0x1064
00001D17
//
// ============================================================
// Phase 5: Store instructions (SW / SB / SH)
// ============================================================
//
// PC=0x068  sw  x1, 0(x4)        mem[64]    = 0x00000005
00122023
// PC=0x06C  sb  x2, 4(x4)        mem[68][7:0] = 0xFB
00220223
// PC=0x070  sh  x1, 8(x4)        mem[72][15:0] = 0x0005
00121423
//
// ============================================================
// Phase 6: Load instructions (LW / LB / LBU / LH / LHU)
// ============================================================
//
// PC=0x074  lw   x27, 0(x4)      x27 = 5
00022D83
// PC=0x078  lb   x28, 4(x4)      x28 = 0xFFFFFFFB  (sign-extend 0xFB)
00420E03
// PC=0x07C  lbu  x29, 4(x4)      x29 = 0xFB = 251
00424E83
// PC=0x080  lh   x30, 8(x4)      x30 = 5
00821F03
// PC=0x084  lhu  x31, 8(x4)      x31 = 5
00825F83
//
// ============================================================
// Phase 7: Branch instructions (BEQ BNE BLT BGE BLTU BGEU)
//
// Pattern per test:
//   B<cond> rs1, rs2, +8   ; taken: skip NOP, land on ADDI
//   NOP                    ; skipped if branch correct
//   addi x5, x5, 1         ; x5 counts correct branches
// ============================================================
//
// PC=0x088  addi x5, x0, 0       reset branch counter
00000293
//
// PC=0x08C  beq  x1, x1, +8      BEQ: 5==5 → taken
00108463
// PC=0x090  nop
00000013
// PC=0x094  addi x5, x5, 1       x5 = 1
00128293
//
// PC=0x098  bne  x1, x3, +8      BNE: 5!=3 → taken
00309463
// PC=0x09C  nop
00000013
// PC=0x0A0  addi x5, x5, 1       x5 = 2
00128293
//
// PC=0x0A4  blt  x2, x1, +8      BLT: -5 < 5 signed → taken
00114463
// PC=0x0A8  nop
00000013
// PC=0x0AC  addi x5, x5, 1       x5 = 3
00128293
//
// PC=0x0B0  bge  x1, x3, +8      BGE: 5 >= 3 signed → taken
0030D463
// PC=0x0B4  nop
00000013
// PC=0x0B8  addi x5, x5, 1       x5 = 4
00128293
//
// PC=0x0BC  bltu x3, x1, +8      BLTU: 3 < 5 unsigned → taken
0011E463
// PC=0x0C0  nop
00000013
// PC=0x0C4  addi x5, x5, 1       x5 = 5
00128293
//
// PC=0x0C8  bgeu x1, x3, +8      BGEU: 5 >= 3 unsigned → taken
0030F463
// PC=0x0CC  nop
00000013
// PC=0x0D0  addi x5, x5, 1       x5 = 6
00128293
//
// ============================================================
// Phase 8: JALR
// ============================================================
//
// PC=0x0D4  addi x4, x0, 0xE0    x4 = 0xE0 (landing pad address)
0E000213
// PC=0x0D8  jalr x3, x4, 0       x3 = 0x0DC, jump to 0x0E0
000201E7
// PC=0x0DC  jal  x0, 0           HALT — skipped if JALR correct
0000006F
// PC=0x0E0  addi x5, x5, 1       JALR landing pad: x5 = 7
00128293
//
// ============================================================
// Halt loop
// ============================================================
//
// PC=0x0E4  jal  x0, 0           infinite loop
0000006F
