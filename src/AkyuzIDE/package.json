{
  "name": "akyuzide",
  "private": true,
  "version": "1.20260520.44",
  "description": "EDA-focused IDE for RISC-V/FPGA development",
  "author": {
    "name": "Taha Tahsin Akyuz",
    "email": "takyuz515@gmail.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node -e \"console.log('\\n>>> AkyuzIDE | http://127.0.0.1:3000 | also start: Python server/ on :8000\\n')\" && vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite",
    "build:desktop": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "@google/genai": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.akyuzide.station",
    "productName": "AkyuzIDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "server/**/*",
      "!server/.venv/**/*",
      "!server/__pycache__/**/*"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": "toolchain/riscv",
        "to": "toolchain/riscv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "tahatahsinakyuz",
      "repo": "AkyuzIDE-releases"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}.${ext}",
      "icon": "public/logo.png",
      "category": "Development"
    },
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico"
    }
  }
}
