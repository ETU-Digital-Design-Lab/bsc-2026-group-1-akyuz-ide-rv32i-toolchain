# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AkyuzIDE varsayılanı: Ollama (local veya tailscale/ngrok tunnel)

# Yerel Ollama (backend + IDE model listesi için)
# localhost yerine 127.0.0.1: bazı Windows kurulumlarında IPv6/proxy sorunlarını önler
OLLAMA_HOST=http://127.0.0.1:11434
REMOTE_AI_HOST=http://127.0.0.1:11434

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

